    echo_info "\nInstalling LTTng UST."
    cd $(mktemp -d) &&
    wget https://lttng.org/files/lttng-ust/lttng-ust-latest-2.13.tar.bz2 &&
    tar -xf lttng-ust-latest-2.13.tar.bz2 &&
    cd lttng-ust-2.13.* &&
