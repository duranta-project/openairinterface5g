<testCaseList>
  <htmlTabName>Sidelink test</htmlTabName>

  <testCase>
    <class>Pull_Local_Registry</class>
    <desc>Pull Images from Local Registry</desc>
    <node>localhost</node>
    <images>oai-nr-ue-asan</images>
  </testCase>

  <testCase>
    <class>Create_Workspace</class>
    <desc>Create new Workspace</desc>
    <node>localhost</node>
  </testCase>

  <testCase>
    <class>Deploy_Object</class>
    <desc>Deploy OAI 5G UE 1</desc>
    <node>localhost</node>
    <yaml_path>ci-scripts/yaml_files/5g_rfsimulator_sidelink</yaml_path>
    <services>oai-nr-ue-1</services>
  </testCase>

  <testCase>
    <class>Deploy_Object</class>
    <desc>Deploy OAI 5G UE 2</desc>
    <node>localhost</node>
    <yaml_path>ci-scripts/yaml_files/5g_rfsimulator_sidelink</yaml_path>
    <services>oai-nr-ue-2</services>
  </testCase>

  <testCase>
    <class>Custom_Command</class>
    <desc>Wait for sync</desc>
    <node>localhost</node>
    <command><![CDATA[for t in {1..30}; do sleep 1; docker logs rfsim5g-oai-nr-ue2 | grep "PSBCH RX:OK" && exit 0; done; exit 1]]></command>
  </testCase>

  <testCase>
    <class>IdleSleep</class>
    <desc>Sleep</desc>
    <idle_sleep_time_in_sec>2</idle_sleep_time_in_sec>
  </testCase>

  <testCase>
    <class>Ping</class>
    <desc>Ping sync-ref from syncing NR-UE</desc>
    <id>rfsim5g_ue2</id>
    <node>localhost</node>
    <svr_id>rfsim5g_ue</svr_id>
    <svr_node>localhost</svr_node>
    <ping_args>-c 20 -i0.5</ping_args>
    <ping_packetloss_threshold>80</ping_packetloss_threshold>
  </testCase>

  <testCase>
    <class>Undeploy_Object</class>
    <always_exec>true</always_exec>
    <desc>Undeploy all OAI 5G stack</desc>
    <node>localhost</node>
    <yaml_path>ci-scripts/yaml_files/5g_rfsimulator_sidelink</yaml_path>
    <analysis>
      <services>oai-nr-ue-1</services>
      <service>oai-nr-ue-2=ContainsString=PSBCH RX:OK</service>
    </analysis>
  </testCase>

  <testCase>
    <class>Clean_Test_Server_Images</class>
    <always_exec>true</always_exec>
    <desc>Clean Test Images on Test Server</desc>
    <node>localhost</node>
    <images>oai-nr-ue-asan</images>
  </testCase>

</testCaseList>
