<testCaseList>
  <htmlTabName>NTN Celeos GEO</htmlTabName>

  <testCase>
    <class>DeployCoreNetwork</class>
    <desc>Initialize 5G Core</desc>
    <cn_id>oc-cn5g-00103-ho</cn_id>
  </testCase>

  <testCase>
    <class>Pull_Local_Registry</class>
    <desc>Pull Images from Local Registry</desc>
    <images>oai-gnb</images>
    <node>groot</node>
  </testCase>

  <testCase>
    <class>Pull_Local_Registry</class>
    <desc>Pull Images from Local Registry</desc>
    <images>oai-nr-ue</images>
    <node>rocket</node>
  </testCase>

  <testCase>
    <class>Create_Workspace</class>
    <desc>Create new Workspace for groot</desc>
    <node>groot</node>
  </testCase>

  <testCase>
    <class>Create_Workspace</class>
    <desc>Create new Workspace on rocket</desc>
    <node>rocket</node>
  </testCase>

  <testCase>
    <class>Create_Workspace</class>
    <desc>Create new Workspace on jetson2-oai</desc>
    <node>jetson2-oai</node>
  </testCase>

  <testCase>
    <class>Custom_Command</class>
    <desc>Start NTN GEO emulation</desc>
    <node>jetson2-oai</node>
    <command>python3 %%workspace%%/ci-scripts/celeos_channel_emulation.py --env /opt/celeos-emulation-client/.env OAI_GEO_band254</command>
  </testCase>

  <testCase>
    <class>Deploy_Object</class>
    <desc>Deploy gNB in a container</desc>
    <yaml_path>ci-scripts/yaml_files/5g_sa_celeos_ntn_geo</yaml_path>
    <node>groot</node>
    <services>oai-gnb</services>
  </testCase>

  <testCase>
    <class>Deploy_Object</class>
    <desc>Deploy nrUE in a container</desc>
    <yaml_path>ci-scripts/yaml_files/5g_sa_celeos_ntn_geo</yaml_path>
    <services>oai-nr-ue</services>
    <node>rocket</node>
  </testCase>

  <testCase>
    <class>Attach_UE</class>
    <desc>Attach nrUE</desc>
    <id>oai_ue_rocket</id>
  </testCase>

  <testCase>
    <class>Ping</class>
    <desc>Ping: 100pings in 20sec</desc>
    <id>oai_ue_rocket</id>
    <svr_id>oc-cn5g-00103-ho</svr_id>
    <ping_args>-c 100 -i 0.2</ping_args>
    <ping_packetloss_threshold>5</ping_packetloss_threshold>
  </testCase>

  <testCase>
    <class>Undeploy_Object</class>
    <always_exec>true</always_exec>
    <desc>Undeploy gNB</desc>
    <node>groot</node>
    <yaml_path>ci-scripts/yaml_files/5g_sa_celeos_ntn_geo</yaml_path>
    <analysis>
      <services>oai-gnb=EndsWithBye</services>
    </analysis>
  </testCase>

  <testCase>
    <class>Undeploy_Object</class>
    <always_exec>true</always_exec>
    <desc>Undeploy nrUE</desc>
    <node>rocket</node>
    <yaml_path>ci-scripts/yaml_files/5g_sa_celeos_ntn_geo</yaml_path>
    <analysis>
      <services>oai-nr-ue=EndsWithBye</services>
    </analysis>
  </testCase>

  <testCase>
    <class>Custom_Command</class>
    <always_exec>true</always_exec>
    <desc>Stop NTN GEO emulation</desc>
    <node>jetson2-oai</node>
    <command>python3 %%workspace%%/ci-scripts/celeos_channel_emulation.py --stop --logs --output /tmp/celeos.log --env /opt/celeos-emulation-client/.env</command>
  </testCase>

  <testCase>
    <class>Custom_Script</class>
    <always_exec>true</always_exec>
    <desc>Collect logs from CELEOS channel emulator</desc>
    <node>localhost</node>
    <script>scripts/remote-collect-log.sh</script>
    <options>/tmp/celeos.log %%log_dir%% jetson2-oai</options>
  </testCase>

  <testCase>
    <class>Clean_Test_Server_Images</class>
    <always_exec>true</always_exec>
    <desc>Clean Test Images on Test Server</desc>
    <node>groot</node>
    <images>oai-gnb</images>
  </testCase>

  <testCase>
    <class>Clean_Test_Server_Images</class>
    <always_exec>true</always_exec>
    <desc>Clean Test Images on Test Server</desc>
    <node>rocket</node>
    <images>oai-nr-ue</images>
  </testCase>

  <testCase>
    <class>UndeployCoreNetwork</class>
    <always_exec>true</always_exec>
    <desc>Terminate 5G Core</desc>
    <cn_id>oc-cn5g-00103-ho</cn_id>
  </testCase>

</testCaseList>
