      <services>oai-gnb-pci0=EndsWithBye</services>
    </analysis>
  </testCase>

  <testCase>
    <class>Undeploy_Object</class>
    <always_exec>true</always_exec>
    <desc>Undeploy Monolithic gNB-PCI1</desc>
    <node>rocket</node>
    <yaml_path>ci-scripts/yaml_files/5g_sa_n2_ho_b210</yaml_path>
