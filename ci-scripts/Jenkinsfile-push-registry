 */

// Location of the python executor node shall be in the same subnet as the others servers
def nodeExecutor = params.nodeExecutor

// Name of the resource
def lockResources = []
if (params.LockResources != null && params.LockResources.trim().length() > 0)
  params.LockResources.trim().split(",").each{lockResources += [resource: it.trim()]}

// Docker Hub account to push to
def DH_Account = params.DH_Account

// Internal Registry to use
def OAI_Registry = params.OAI_Registry

pipeline {
  agent {
    label nodeExecutor
  }
  options {
    ansiColor('xterm')
    lock(extra: lockResources)
  }
  stages {
    stage ("Verify Parameters") {
      steps {
        script {
          echo '\u2705 \u001B[32mVerify Parameters\u001B[0m'
          def allParametersPresent = true

          // It is already to late to check it
          if (params.nodeExecutor != null) {
            echo "Docker Push executor node  :   ${nodeExecutor}"
          }
          if (params.LockResources == null) {
            echo "no LockResources given"
            allParametersPresent = false
          }
          if (!DH_Account || !OAI_Registry) {
            error "DH_Account and OAI_Registry parameters are required"
          }
        }
      }
    }
    stage ("Push to DockerHub") {
      steps {
        script {
          def IMAGE_TAG = params.releaseTag?.trim() ?: params.weeklyTag?.trim()
          def COMMIT_SHA
          if (IMAGE_TAG) {
            // A given tag publishes the CI images built from the tagged commit
            sh "git fetch --force origin tag ${IMAGE_TAG} --no-tags"
            COMMIT_SHA = sh(returnStdout: true, script: "git rev-parse --verify ${IMAGE_TAG}^{commit}").trim()
          } else {
            IMAGE_TAG = sh(returnStdout: true, script: 'date +"%Y.w%V"').trim()
            COMMIT_SHA = sh(returnStdout: true, script: 'git log -n1 --pretty=format:"%H" origin/develop').trim()
          }
          echo "Tag is ${IMAGE_TAG} (commit ${COMMIT_SHA})"

          withCredentials([
            [$class: 'UsernamePasswordMultiBinding', credentialsId: "${params.DH_Credentials}", usernameVariable: 'DH_Username', passwordVariable: 'DH_Password'],
            [$class: 'UsernamePasswordMultiBinding', credentialsId: "${params.REGISTRY_Credentials}", usernameVariable: 'REGISTRY_Username', passwordVariable: 'REGISTRY_Password']
          ]) {
            def listOfImages = ["oai-enb", "oai-gnb", "oai-lte-ue", "oai-nr-ue", "oai-nr-cuup", "oai-gnb-fhi72"]
            sh 'echo "$DH_Password" | docker login -u "$DH_Username" --password-stdin > /dev/null 2>&1'
            sh 'echo "$REGISTRY_Password" | docker login -u "$REGISTRY_Username" --password-stdin ' + OAI_Registry + ' > /dev/null 2>&1'
            listOfImages.each { item ->
              def tags = "--tag ${DH_Account}/${item}:${IMAGE_TAG}"
              // Release run: publish under the release tag only, without updating develop
              if (!params.releaseTag?.trim()) {
                tags += " --tag ${DH_Account}/${item}:develop"
              }
              if (["oai-gnb", "oai-nr-ue", "oai-nr-cuup"].contains(item)) {
                echo "Pushing image '${item}' for both AMD64 and ARM64 architectures"
                sh "docker buildx imagetools create ${tags} ${OAI_Registry}/${item}:armv8_develop-${COMMIT_SHA} ${OAI_Registry}/${item}:develop-${COMMIT_SHA}"
              } else {
                sh "docker buildx imagetools create ${tags} ${OAI_Registry}/${item}:develop-${COMMIT_SHA}"
              }
            }
          }
        }
      }
    }
  }
  post {
    always {
      script {
        sh "docker logout ${OAI_Registry} > /dev/null 2>&1"
        sh "docker logout > /dev/null 2>&1"
      }
    }
  }
}
