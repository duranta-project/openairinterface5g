# SPDX-License-Identifier: LicenseRef-CSSL-1.0

#---------------------------------------------------------------------
#
# Dockerfile for the Open-Air-Interface gNB with the E3 agent, for RF simulation
#               Valid for UBUNTU 24.04
#
# The gNB comes from the ran-build-e3 image; only the pieces an RFsim gNB uses
# are copied, plus libe3 and the libraries it links.
#
#---------------------------------------------------------------------

ARG UBUNTU_IMAGE=ubuntu:noble

FROM ran-base:latest AS gnb-base

FROM ran-build-e3:latest AS gnb-build

FROM ${UBUNTU_IMAGE} AS oai-gnb
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

RUN apt-get update && \
    apt-get upgrade --yes && \
    apt-get install --yes \
        procps \
        libsctp1 \
        tzdata \
        libconfig9 \
        openssl \
        net-tools \
        iproute2 \
        iputils-ping \
        libyaml-cpp-dev \
        libzmq5 \
        libprotobuf-c1 \
        libprotobuf32t64 && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/oai-gnb/bin
COPY --from=gnb-build \
    /oai-ran/cmake_targets/ran_build/build/nr-softmodem ./
COPY ./docker/scripts/gnb_entrypoint.sh ./entrypoint.sh

COPY --from=gnb-build \
    /oai-ran/cmake_targets/ran_build/build/librfsimulator.so \
    /oai-ran/cmake_targets/ran_build/build/libcoding.so \
    /oai-ran/cmake_targets/ran_build/build/libparams_libconfig.so \
    /oai-ran/cmake_targets/ran_build/build/libparams_yaml.so \
    /oai-ran/cmake_targets/ran_build/build/libdfts.so \
    /oai-ran/cmake_targets/ran_build/build/libldpc*.so \
    /usr/local/lib/
COPY --from=gnb-build /usr/local/lib/liblibe3.so* /usr/local/lib/

RUN ldconfig && \
    echo "---- ldd on nr-softmodem ----" && \
    ldd /opt/oai-gnb/bin/nr-softmodem && \
    echo "---- ldd on shared libraries ----" && \
    ldd /usr/local/lib/librfsimulator.so \
        /usr/local/lib/libcoding.so \
        /usr/local/lib/libparams_libconfig.so \
        /usr/local/lib/libparams_yaml.so \
        /usr/local/lib/libdfts.so \
        /usr/local/lib/libldpc*.so \
        /usr/local/lib/liblibe3.so*

WORKDIR /opt/oai-gnb

COPY --from=gnb-base /usr/local/bin/yq /usr/local/bin/yq
COPY --from=gnb-base /tini /tini
ENTRYPOINT ["/tini", "-v", "--", "/opt/oai-gnb/bin/entrypoint.sh"]
CMD ["/opt/oai-gnb/bin/nr-softmodem"]
